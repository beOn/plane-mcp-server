# Deterministic test credentials for ephemeral test stack.
# These are throwaway — never used in production.

DEBUG=1
CORS_ALLOWED_ORIGINS="http://localhost:18000"

# Database — points to test-db container
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_HOST="test-db"
POSTGRES_DB="plane"
POSTGRES_PORT=5432
DATABASE_URL=postgresql://plane:plane@test-db:5432/plane

# Redis — points to test-redis container
REDIS_HOST="test-redis"
REDIS_PORT="6379"
REDIS_URL="redis://test-redis:6379/"

# RabbitMQ — points to test-mq container
RABBITMQ_HOST="test-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# Minio — points to test-minio container
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://test-minio:9000"
AWS_S3_BUCKET_NAME="uploads"
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600

DOCKERIZED=1
USE_MINIO=1

WEB_URL="http://localhost:18000"
GUNICORN_WORKERS=2

ADMIN_BASE_URL="http://localhost:18000"
ADMIN_BASE_PATH="/god-mode"
SPACE_BASE_URL="http://localhost:18000"
SPACE_BASE_PATH="/spaces"
APP_BASE_URL="http://localhost:18000"
APP_BASE_PATH=""
LIVE_BASE_URL="http://localhost:18000"
LIVE_BASE_PATH="/live"
LIVE_SERVER_SECRET_KEY="test-secret-key"

HARD_DELETE_AFTER_DAYS=60
MINIO_ENDPOINT_SSL=0
API_KEY_RATE_LIMIT="300/minute"
SECRET_KEY="test-secret-key-for-ephemeral-stack-only"
